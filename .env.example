# ==============================================================================
# Pragati Enterprises Data Platform - Environment Configuration Template
# Instructions: Copy this file to '.env' and populate with production secrets.
# ==============================================================================

# --- Local On-Premises MySQL Database Credentials ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_mysql_password_here
DB_NAME=pragati_logistics_dw

# --- AWS S3 Storage Layer Credentials (IAM Restricted User) ---
AWS_ACCESS_KEY_ID=your_aws_iam_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_iam_secret_key_here
AWS_REGION=ap-south-1

# --- S3 Bucket & Object Routing Paths ---
S3_RAW_BUCKET=pragati-raw-landing
S3_ARCHIVE_BUCKET=pragati-analytics-silver
S3_DAILY_FEED_KEY=daily_transit_feed.csv
